{
  "name": "example-search",
  "params": {
    "alpha": {"type": "float", "low": 0.0, "high": 1.0},
    "cooling": {"type": "float", "low": 0.001, "high": 1.0, "log": true},
    "iters": {"type": "int", "low": 100, "high": 100000, "log": true},
    "strategy": {"type": "cat", "choices": ["greedy", "anneal"]}
  },
  "command": ["python", "solver.py", "--alpha", "__alpha__", "--cooling", "__cooling__", "--iters", "__iters__", "--strategy", "__strategy__", "--seed", "__seed__", "--out", "out/solution.txt"],
  "instances": [1, 2, 3, 4, 5],
  "timeout_sec": 60,
  "artifacts": ["out/solution.txt"]
}
